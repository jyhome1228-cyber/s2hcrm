// TEMPORARY inspection rules. Review and publish in Firebase Console only when intended.
// This file is NOT automatically deployed by GitHub Pages.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow write: if false;
    }
    match /sellers/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }
    match /products/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }
    match /groupbuys/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }
    match /activities/{id} {
      allow read: if isAdmin();
      // Admin-only maintenance permits replaying historical audit records into EMPTY collections.
      // Restore UI rejects existing target records and does not permit overwriting.
      // Revert to stricter operational rules after inspection.
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
